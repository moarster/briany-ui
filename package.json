{
  "name": "briany-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "api:generate": "openapi-ts",
    "api:check": "openapi-ts && git diff --exit-code src/api/generated",
    "contract:update": "git submodule update --remote contract && pnpm api:generate",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check:arch": "./scripts/check-architecture.sh",
    "check:no-scripts": "./scripts/check-no-script-tasks.sh",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:no-scripts && pnpm check:arch && pnpm build && pnpm check:budget",
    "check:budget": "./scripts/check-bundle-budget.sh"
  },
  "dependencies": {
    "@bpmn-io/form-js": "^1.19.0",
    "@bpmn-io/properties-panel": "^3.32.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-xml": "^6.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.2",
    "bpmn-js": "^18.6.2",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "^11.7.0",
    "date-fns": "^4.1.0",
    "diagram-js": "^15.5.1",
    "dmn-js": "^17.4.0",
    "dmn-js-properties-panel": "^3.5.1",
    "lucide-react": "^0.545.0",
    "preact": "^10.29.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tiny-svg": "^4.1.4",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@hey-api/openapi-ts": "^0.87.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/router-plugin": "^1.132.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "msw": "^2.11.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.3.4"
}
